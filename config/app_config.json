{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "project": {
    "name": "DirectionSignalSender",
    "package_name": "com.direction.signalsender",
    "version_name": "1.0.0",
    "version_code": 1,
    "min_sdk": 24,
    "target_sdk": 34,
    "compile_sdk": 34
  },
  "sectors": {
    "north": {
      "name": "NORTH",
      "signal": 1,
      "center_deg": 0.0,
      "start_deg": 315.0,
      "end_deg": 45.0,
      "crosses_zero": true
    },
    "west": {
      "name": "WEST",
      "signal": 2,
      "center_deg": 270.0,
      "start_deg": 225.0,
      "end_deg": 315.0,
      "crosses_zero": false
    },
    "south": {
      "name": "SOUTH",
      "signal": 3,
      "center_deg": 180.0,
      "start_deg": 135.0,
      "end_deg": 225.0,
      "crosses_zero": false
    },
    "east": {
      "name": "EAST",
      "signal": 4,
      "center_deg": 90.0,
      "start_deg": 45.0,
      "end_deg": 135.0,
      "crosses_zero": false
    }
  },
  "stability": {
    "sampling_rate_ms": 40,
    "window_size_ms": 1000,
    "min_samples_in_window": 12,
    "max_angular_spread_deg": 7.0,
    "moving_angular_velocity_threshold_deg_per_sec": 15.0,
    "stable_duration_threshold_ms": 800,
    "max_total_latency_target_ms": 1800
  },
  "networking": {
    "default_endpoint_url": "https://example.com/api/direction",
    "connect_timeout_seconds": 5,
    "read_timeout_seconds": 5,
    "write_timeout_seconds": 5,
    "retry_on_failure": false,
    "json_key": "signal"
  },
  "background_service": {
    "channel_id": "direction_monitor_service_channel",
    "channel_name": "Direction Monitoring Service",
    "notification_id": 1001,
    "wake_lock_tag": "DirectionMonitor::SensorWakeLock",
    "wake_lock_timeout_ms": 86400000
  }
}
